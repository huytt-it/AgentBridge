// Template for appsettings.Local.json: copy this file to appsettings.Local.json (same folder) and edit it.
// appsettings.Local.json holds everything specific to this machine and is ignored by git.
// Comments are allowed in these files. Use forward slashes or doubled backslashes in paths.
{
  "AgentBridge": {
    // Name of this machine as the cloud sees it (letters, digits, '-').
    "AgentId": "my-laptop",

    // The folder inside Box Drive that Microsoft 365 Copilot can read and write. Absolute path.
    "BoxRoot": "C:/Users/<you>/Box/AgentBridge",

    // Optional. Job state and full logs; never synced. Default: %LOCALAPPDATA%/AgentBridge.
    // "LocalDataRoot": "C:/AgentBridgeData",

    // Names the cloud may use for "target". The path stays local; only name and description are published.
    "Targets": {
      // "TradingSystem": { "Path": "D:/Work/Projects/TradingSystem", "Description": "Source code of the trading system" }
    },

    // Local MCP servers, started over STDIO. See docs/onboarding-mcp-server.md.
    "McpServers": {
      // "codemap": { "Command": "node", "Args": [ "C:/tools/codemap/index.js" ] }
    },

    // Capabilities: "cli" entries (docs/onboarding-cli-tool.md) and "mcp" entries (docs/onboarding-mcp-server.md).
    // Every entry here is visible to the cloud once the worker restarts. Ask the user before adding one.
    "Capabilities": {
    }
  }
}
