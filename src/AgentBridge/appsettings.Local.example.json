// Template for appsettings.Local.json: copy this file to appsettings.Local.json (same folder) and edit it.
// appsettings.Local.json holds everything specific to this machine and is ignored by git.
// Comments are allowed in these files. Use forward slashes or doubled backslashes in paths.
{
  "AgentBridge": {
    // Optional. Name of this machine as the cloud sees it (letters, digits, '-'). Default: the machine name.
    // "AgentId": "my-laptop",

    // Optional. The folder inside Box Drive that Microsoft 365 Copilot can read and write. Absolute path.
    // Default: %USERPROFILE%/Box/AgentBridge, the folder name the cloud instruction in docs/cloud-agent.md uses.
    // Set it when your organisation does not allow folders at the root of Box, and change the folder name in the
    // cloud instruction to match.
    // "BoxRoot": "C:/Users/<you>/Box/Team/AgentBridge",

    // Optional. Job state and full logs; never synced. Default: %LOCALAPPDATA%/AgentBridge.
    // "LocalDataRoot": "C:/AgentBridgeData",

    // Optional. How many days of worker log files (LocalDataRoot/logs/agentbridge-yyyyMMdd.log) are kept. Default 14.
    // "LogRetentionDays": 14,

    // Names the cloud may use for "target". The path stays local; only name and description are published.
    "Targets": {
      // "DemoRepo": { "Path": "D:/Repos/DemoRepo", "Description": "Source code of the demo application" }
    },

    // Local MCP servers, started over STDIO. See docs/onboarding-mcp-server.md.
    "McpServers": {
      // "codemap": { "Command": "node", "Args": [ "C:/tools/codemap/index.js" ] }
    },

    // Capabilities: "cli" entries (docs/onboarding-cli-tool.md) and "mcp" entries (docs/onboarding-mcp-server.md).
    // Every entry here is visible to the cloud once the worker restarts. Ask the user before adding one.
    // The first part of a name is its business domain: "backlog.export" belongs to "backlog".
    "Capabilities": {
    },

    // Optional. Business descriptions of the domains, published in catalog.json. A domain without an entry is still
    // published by name. "Enabled": false switches off every capability of the domain.
    "Domains": {
      // "backlog": {
      //   "Description": "The backlog of a project: work items with their status and priority.",
      //   "UseWhen": "The user asks about the scope, progress or open work of a project.",
      //   "ExampleQuestions": [ "What is still open in project DEMO?" ]
      // },
      // "code": {
      //   "Description": "The source code of the applications: where business rules are implemented.",
      //   "UseWhen": "The user asks how or where something is implemented.",
      //   "ExampleQuestions": [ "Where is settlement handled in DemoRepo?" ]
      // }
    },

    // Optional. Business goals that need several capabilities in order. Guidance for the cloud, which sends one request
    // per step; nothing runs a playbook locally. Every step must name a capability of this agent.
    "Playbooks": {
      // "backlog-impact": {
      //   "Goal": "Find which parts of the code the open backlog items of a project touch.",
      //   "UseWhen": "The user asks what the open work of a project means for the code.",
      //   "ExampleQuestions": [ "Which parts of DemoRepo do the open DEMO items affect?" ],
      //   "Steps": [
      //     { "Capability": "backlog.export", "Purpose": "Get the open items of the project." },
      //     { "Capability": "code.search", "Purpose": "Search the code for the business terms of each item." }
      //   ]
      // }
    }
  }
}
