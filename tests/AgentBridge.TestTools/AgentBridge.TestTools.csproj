<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stand-in tools for the tests: a fake command-line tool and a fake MCP server. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      The tools run from the test output folder, and the net10.0 folder lacks net8.0 package assemblies such as
      System.Text.Json; on the newest runtime those are built in.
    -->
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
  </ItemGroup>

</Project>
